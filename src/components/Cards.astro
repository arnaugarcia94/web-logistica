---
import { href, type Page } from '../lib/content';
interface Props { pages: Page[] }
const { pages } = Astro.props;
---
<div class="cards">{pages.map(p => <a class="card" href={href(p)}><span class="card-top"><span class="eyebrow">{p.type === 'hub' ? 'Área de conocimiento' : p.type === 'subvertical' ? 'Tema' : 'Guía'}</span><span aria-hidden="true">↗</span></span><h3>{p.title}</h3><p>{p.description}</p><span class="card-link">Explorar {p.type === 'informativa' ? 'guía' : 'tema'} <span aria-hidden="true">→</span></span></a>)}</div>
