---
import ContextNav from '../components/ContextNav.astro';
import type { Page } from '../lib/content';
interface Props { page: Page }
const { page } = Astro.props;
---
<div class="page-heading"><p class="eyebrow">Guía introductoria</p><h1>{page.title}</h1><p class="lead">{page.description}</p></div><div class="content-grid"><article class="prose">{page.sections.map(section => <section><h2>{section.heading}</h2>{section.paragraphs.map(text => <p>{text}</p>)}</section>)}</article><ContextNav page={page} /></div>
